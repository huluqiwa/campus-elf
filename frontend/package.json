{
  "name": "campus-elf-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm build && playwright test",
    "audit": "pnpm audit --audit-level high",
    "dev:admin": "pnpm --filter admin dev",
    "dev:campus": "pnpm --filter campus dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
