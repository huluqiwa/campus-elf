# ============================================================
# 校园陪伴精灵 .env.example
# 复制为 .env 后填写真实值；.env 绝对不要提交
# 本文件只放占位符，不得出现任何真实密钥
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=CampusCompanionElf
APP_SECRET_KEY=change-me
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# ---------- PostgreSQL ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=campus_elf
POSTGRES_USER=campus_elf
POSTGRES_PASSWORD=change-me
# 三连接分离（见 docs/design.md §4.6）：运行时必须用**非超级用户**，否则 RLS 被绕过。
# 1) 租户侧应用连接（campus_elf_tenant 组成员）
DATABASE_URL=postgresql+asyncpg://campus_elf_tenant_app:change-me@127.0.0.1:5432/campus_elf
# 2) 平台侧应用连接（campus_elf_platform 组成员，可读平台表与审计表）
PLATFORM_DATABASE_URL=postgresql+asyncpg://campus_elf_platform_app:change-me@127.0.0.1:5432/campus_elf
# 3) 迁移连接（DDL/建策略；仅迁移 Job 注入，**不要**给 API/Worker 使用）。
#    该角色必须是超级用户或 BYPASSRLS（FORCE RLS 下 SECURITY DEFINER 开通函数需要）。
MIGRATION_DATABASE_URL=postgresql+asyncpg://campus_elf:change-me@127.0.0.1:5432/campus_elf

# ---------- Redis ----------
# REDIS_URL 必填（无默认值）：缺失时应用/Worker 启动即失败，不会回退到无凭证的本机 DB 0。
# 密码需与 deploy/.env 的 REDIS_PASSWORD 一致。
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
REDIS_PREFIX=campus_elf

# ---------- JWT / 认证 ----------
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MFA_ISSUER=CampusCompanionElf
PASSWORD_BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
PASSWORD_HISTORY_SIZE=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 字段加密 / 查重 ----------
ENCRYPTION_KEK=change-me
HMAC_PEPPER=change-me

# ---------- LLM / VLM ----------
LLM_API_KEY=change-me
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=example-llm
VLM_API_KEY=change-me
VLM_BASE_URL=https://api.example.com/v1
VLM_MODEL=example-vlm

# ---------- 嵌入 / 重排（TEI CPU） ----------
EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://127.0.0.1:8082
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_MS=300

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=campus_elf

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
# 与 deploy/.env 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 保持一致
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=campus-elf
MINIO_SECURE=false

# ---------- MinerU 4.0.12 解析服务 ----------
MINERU_BASE_URL=http://127.0.0.1:8100
MINERU_API_KEY=
MINERU_DEFAULT_TIER=standard
MINERU_FALLBACK_TIERS=basic,flash
MINERU_TIMEOUT_SECONDS=300
MINERU_MAX_CONCURRENCY=1
MINERU_CONFIG_HOME=/data/mineru

# ---------- ClamAV ----------
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_FAIL_CLOSED=true

# ---------- 邮件（仅 MailHog UI 端口；SMTP 配置见文件后部 M1-B 小节） ----------
MAILHOG_UI_PORT=8025

# ---------- 内容安全 ----------
CONTENT_SAFETY_PROVIDER=local
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_BASE_URL=
CONTENT_SAFETY_FAIL_CLOSED=true

# ---------- Langfuse（生产独立主机；开发可选） ----------
# 版本锁定：Server 4.63.0 / Python SDK 5.0.2（SDK 版本由 pyproject 锁定）
# 自托管可选实时入库：Langfuse 容器环境变量 LANGFUSE_MIGRATION_V4_NATIVE_OTEL_BEHAVIOUR=direct
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_SCENARIOS=kb_test,c_feedback,customization
LANGFUSE_TRACE_RETENTION_DAYS=180

# ---------- 上传限制 ----------
UPLOAD_MAX_FILES_PER_BATCH=15
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_BATCH_SIZE_MB=300
PERSONAL_KB_MAX_FILE_SIZE_MB=30

# ---------- 配额 / 限流（首版基础值） ----------
TENANT_DAILY_REQUESTS=10000
TENANT_DAILY_TOKENS=2000000
TENANT_MAX_CONCURRENT_STREAMS=50
TENANT_STORAGE_BYTES=5368709120
USER_RATE_LIMIT_PER_MINUTE=30

# ---------- 审批 ----------
APPROVAL_REMINDER_HOURS=24
APPROVAL_ESCALATE_HOURS=48

# ---------- 开发/测试开关（生产必须为 false） ----------
DEV_SKIP_SCHOOL_REVIEW=false
DEV_SKIP_FILE_SCAN=false
DEV_EXPOSE_INTERNAL_ERRORS=false
# 空壳 Loop（无 LLM、无认证，仅联调用）；production 下开启会被配置校验直接拒绝。
DEV_SKELETON_LOOP_ENABLED=false

# ---------- 学校注册与审核（M1-B） ----------
# 开发/测试专用：平台审核接口的临时令牌（Authorization: Bearer <值>）；
# production 禁止配置（M1-C 用正式登录替换后删除）。
DEV_PLATFORM_REVIEW_TOKEN=change-me

# ---------- 邮件（开发用 MailHog：127.0.0.1:1025） ----------
# production 必须使用真实 SMTP：TLS/STARTTLS 至少启用一项，且必须配置用户名/密码；
# 127.0.0.1/localhost/mailhog 与 @campus-elf.local 会被配置校验拒绝。
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@campus-elf.local
# 465 端口用隐式 TLS；587 端口用 STARTTLS（二选一）
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- 对象存储（开发/测试：local 目录；生产：s3/MinIO） ----------
OBJECT_STORE_BACKEND=local
OBJECT_STORE_DIR=.zcode/tmp/objects
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=campus-elf

# ---------- 功能开关（MVP 默认关闭） ----------
ENABLE_ANNOUNCEMENTS=false
ENABLE_MCP_SKILLS=false
ENABLE_PERSONAL_KB=false
ENABLE_PERSONAL_SCHEDULE=false
ENABLE_LONG_TERM_MEMORY=false
ENABLE_CAMPUS_WALL=false
ENABLE_TASKS_POINTS=false
ENABLE_PSYCH_ALERT=false
ENABLE_SKIN_CENTER=false
ENABLE_CREATION_CENTER=false
ENABLE_BILLING=false

# ---------- 前端 ----------
# 前端变量请放在 frontend/.env（见 frontend/.env.example）；Vite 不读取根目录 .env。
# 留空 VITE_API_BASE_URL = 同源相对路径，由 Vite/Nginx 代理 /health 与 /api 到后端。
VITE_SSE_HEARTBEAT_MS=15000
