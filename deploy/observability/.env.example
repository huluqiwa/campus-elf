# Langfuse 4.63.0 开发观测栈配置示例（独立 compose，非 profile）。
# 复制为 deploy/observability/.env 并替换所有 change-me：
#   SALT / ENCRYPTION_KEY / NEXTAUTH_SECRET：openssl rand -hex 32
#   POSTGRES_PASSWORD / REDIS_AUTH / CLICKHOUSE_PASSWORD / MINIO_ROOT_PASSWORD：openssl rand -hex 24
#   口令保持 hex（URL 安全）：POSTGRES_PASSWORD 会被拼进 DATABASE_URL。
# 敏感项在 compose 中为必填（${VAR:?…}），缺失会直接报错，不会用默认凭据启动。
# 生产观测独立主机也必须使用强随机值。

NEXTAUTH_URL=http://127.0.0.1:3000
POSTGRES_VERSION=17-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# DATABASE_URL 由 compose 用上面的 POSTGRES_* 拼装，不要在此维护（避免改密码漏改连接串导致 P1000）。

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me

REDIS_AUTH=change-me

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=change-me

SALT=change-me
ENCRYPTION_KEY=change-me
NEXTAUTH_SECRET=change-me

LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=change-me

TELEMETRY_ENABLED=false
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true

# 首次启动创建 org/project/用户（仅开发验证用）
LANGFUSE_INIT_ORG_ID=campus-elf
LANGFUSE_INIT_ORG_NAME=CampusElf
LANGFUSE_INIT_PROJECT_ID=campus-elf
LANGFUSE_INIT_PROJECT_NAME=campus-elf
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me
