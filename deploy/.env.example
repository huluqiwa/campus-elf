# Compose 依赖栈配置示例（不要提交真实 deploy/.env）
# 复制为 deploy/.env 并替换所有 change-me；生产使用强随机值。

POSTGRES_DB=campus_elf
POSTGRES_USER=campus_elf
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=campus_elf
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=campus-elf
# 由 deploy/minio/Dockerfile 从官方源码构建；不要用 latest
MINIO_IMAGE=minio:RELEASE.2025-10-15T17-29-55Z

# MinerU 4.0.12 本地镜像（需先构建，见 deploy/mineru/README.md）
MINERU_IMAGE=mineru:4.0.12
