# 独立测试依赖栈配置示例（M0-F）。
# 复制为 deploy/.env.test 并替换所有 change-me；或直接运行 scripts/test-stack.sh up
# （脚本会在缺失时自动生成强随机值）。生产/开发凭据不在此文件。

TEST_POSTGRES_DB=campus_elf_test
TEST_POSTGRES_USER=campus_elf_test
TEST_POSTGRES_PASSWORD=change-me

TEST_REDIS_PASSWORD=change-me

TEST_MINIO_ROOT_USER=campus_elf_test
TEST_MINIO_ROOT_PASSWORD=change-me

# 测试栈使用的 MinIO 镜像 tag（本地源码构建产物，见 deploy/minio/README.md）
TEST_MINIO_IMAGE=minio:RELEASE.2025-10-15T17-29-55Z
